                (_file "../../../../rtl/vendor/pg2l200h/memory/tile_cache_bank_ip.v" (_format verilog))
            )
        )
        (_widget wgt_my_ips_src
            (_input
                (_ip "../../../../rtl/vendor/pg2l200h/ddr/wr_fram_buf/wr_fram_buf.idf")
                (_ip "../../../../rtl/vendor/pg2l200h/ddr/rd_fram_buf/rd_fram_buf.idf")
