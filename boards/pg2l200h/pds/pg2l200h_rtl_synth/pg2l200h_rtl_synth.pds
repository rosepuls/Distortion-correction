(_flow pg2l200h_rtl_synth "2022.2-SP6.4"
    (_version "1.1.0")
    (_status "initial")
    (_project
        (_option prj_work_dir (_string "."))
        (_option prj_impl_dir (_string "."))
    )
    (_task tsk_setup
        (_widget wgt_select_arch
            (_input (_part (_family Logos2) (_device PG2L200H) (_speedgrade -6) (_package FBB676)))
        )
        (_widget wgt_my_design_src
            (_input
                (_file "../../../../rtl/algorithm/distortion/coordinate_gen.sv" (_format systemverilog))
                (_file "../../../../rtl/algorithm/distortion/coordinate_split.sv" (_format systemverilog))
                (_file "../../../../rtl/algorithm/distortion/normalize.sv" (_format systemverilog))
                (_file "../../../../rtl/algorithm/distortion/distortion_core.sv" (_format systemverilog))
                (_file "../../../../rtl/algorithm/distortion/distortion_core_optimized.sv" (_format systemverilog))
                (_file "../../../../rtl/algorithm/distortion/distortion_image_pipeline.sv" (_format systemverilog))
                (_file "../../../../rtl/algorithm/interpolation/bilinear_interp.sv" (_format systemverilog))
                (_file "../../../../rtl/platform/common/control/algorithm_reset_tree.sv" (_format systemverilog))
                (_file "../../../../rtl/platform/common/memory/pixel_fetch_if.sv" (_format systemverilog))
                (_file "../../../../rtl/platform/common/memory/pixel_fetch_engine.sv" (_format systemverilog))
                (_file "../../../../rtl/platform/common/memory/pixel_tile_cache.sv" (_format systemverilog))
                (_file "../../../../rtl/platform/common/memory/tile_cache_bank_ram.sv" (_format systemverilog))
                (_file "../../../../rtl/platform/common/memory/ddr_burst_reader.sv" (_format systemverilog))
                (_file "../../../../rtl/platform/common/memory/cached_pixel_fetch_engine.sv" (_format systemverilog))
                (_file "../../../../rtl/platform/common/memory/coordinate_fifo.sv" (_format systemverilog))
                (_file "../../../../rtl/board/pg2l200h/reset_sync.sv" (_format systemverilog))
                (_file "../../../../rtl/board/pg2l200h/distortion_frame_processor.sv" (_format systemverilog))
                (_file "../../../../rtl/board/pg2l200h/algorithm_frame_writer.sv" (_format systemverilog))
                (_file "../../../../rtl/board/pg2l200h/algorithm_frame_writer_rgbx.sv" (_format systemverilog))
                (_file "../../../../rtl/board/pg2l200h/board_video_control.sv" (_format systemverilog))
                (_file "../../../../rtl/board/pg2l200h/ddr3_frame_reader.sv" (_format systemverilog))
                (_file "../../../../rtl/board/pg2l200h/ddr3_frame_reader_rgbx.sv" (_format systemverilog))
                (_file "../../../../rtl/board/pg2l200h/ddr3_pixel_read_adapter.sv" (_format systemverilog))
                (_file "../../../../rtl/board/pg2l200h/ddr3_rgbx_cache_adapter.sv" (_format systemverilog))
                (_file "../../../../rtl/board/pg2l200h/ddr_two_client_arbiter.sv" (_format systemverilog))
                (_file "../../../../rtl/board/pg2l200h/realtime_frame_scheduler.sv" (_format systemverilog))
                (_file "../../../../rtl/board/pg2l200h/video_mode_720p60.sv" (_format systemverilog))
                (_file "../../../../rtl/board/pg2l200h/pg2l200h_board_top.sv" + "pg2l200h_board_top" (_format systemverilog))
                (_file "../../../../rtl/vendor/pg2l200h/hdmi/iic_dri.v" (_format verilog))
                (_file "../../../../rtl/vendor/pg2l200h/hdmi/ms7200_ctl.v" (_format verilog))
                (_file "../../../../rtl/vendor/pg2l200h/hdmi/ms7210_ctl.v" (_format verilog))
                (_file "../../../../rtl/vendor/pg2l200h/hdmi/ms72xx_ctl.v" (_format verilog))
                (_file "../../../../rtl/vendor/pg2l200h/ddr/rd_ctrl.v" (_format verilog))
